# OS / editors
.DS_Store
*.swp
.vscode/
.idea/

# Scratch and local tooling
tmp/
scratch/
node_modules/

# Source material: internal or client-confidential, never commit
**/assets/source/*.pdf
**/assets/source/*.pptx
**/assets/source/*.docx
sources/

# Screenshots of internal decks used as references
**/assets/source/*.png

# Agent skills under Anthropic's proprietary licence: installed locally, not redistributed
.agents/skills/pdf/
.agents/skills/pptx/
.claude/skills/pdf
.claude/skills/pptx

# Client editions of the deck: client names, brand and programme content. Never commit, never push.
editions/

# Claude Code worktrees
.claude/worktrees/

# Browser checks: shots, reports, baselines (the repository's and each deck's)
/qa/
decks/*/qa/

# The starter deck builds into its own folder
framework/starter/dist/
framework/starter/qa/

# Stop maps and board files the deck tools write
.deck/
