{
  "name": "zenika-decks",
  "private": true,
  "description": "Zenika's line-art decks, one package each under decks/, on the deck framework (framework/)",
  "type": "module",
  "workspaces": [
    "decks/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces && npm run site",
    "site": "node framework/build/site.mjs --title \"Zenika decks\" --fonts brand/zenika/fonts.css --logo brand/zenika/zenika-monogram.png",
    "gate": "npm run gate --workspaces",
    "check:private": "node framework/build/check-private.mjs",
    "check:copy": "npm run check:copy --workspaces",
    "check:docs": "node framework/build/check-docs.mjs && npm run check:docs --workspaces",
    "new-deck": "node framework/build/new-deck.mjs"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "three": "0.187.0"
  }
}
